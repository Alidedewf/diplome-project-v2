{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "frontend", "--", "--port", "5173", "--strictPort"],
      "port": 5173
    },
    {
      "name": "backend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "backend"],
      "port": 3000
    },
    {
      "name": "frontend-mocks",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "set VITE_USE_MOCKS=1&& npm run dev --prefix frontend -- --port 5174 --strictPort"],
      "port": 5174
    }
  ]
}
