{
  "name": "bookmind-backend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --watch-path=src src/server.js",
    "start": "node src/server.js",
    "db:migrate": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "load:books": "node scripts/load-books.js",
    "load:embeddings": "node scripts/load-embeddings.js",
    "load:wikidata-ru": "node scripts/load-wikidata-ru.js",
    "load:annotations-ru": "node scripts/load-annotations-ru.js",
    "load:own-books": "node scripts/load-own-books.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@duckdb/node-api": "^1.4.5-r.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "pg-copy-streams": "^7.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "prisma": "^7.10.1",
    "supertest": "^7.3.1",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "@prisma/engines@7.10.1": true,
    "prisma@7.10.1": true
  }
}
