# Скопировать в .env и поменять пароли. .env в git не попадает.

# --- PostgreSQL (docker-compose.yml) ---
POSTGRES_USER=bookmind
POSTGRES_PASSWORD=change-me
POSTGRES_DB=bookmind
POSTGRES_PORT=5432

# --- Бэкенд (backend/) ---
DATABASE_URL=postgresql://bookmind:change-me@localhost:5432/bookmind
# База для тестов создаётся автоматически при `npm test`
TEST_DATABASE_URL=postgresql://bookmind:change-me@localhost:5432/bookmind_test
# Секрет для подписи JWT: длинная случайная строка
JWT_SECRET=change-me-to-a-long-random-string
PORT=3000
# Адрес фронтенда для CORS (Vite)
CORS_ORIGIN=http://localhost:5173

# --- ML-сервис (ml/src/service, FastAPI) ---
# Эмбеддинг поискового запроса; не отвечает за ML_TIMEOUT_MS — поиск без смысловой части.
# 127.0.0.1, а не localhost: в Windows localhost сначала пробует IPv6 — +200–400 мс на запрос
ML_SERVICE_URL=http://127.0.0.1:8000
ML_TIMEOUT_MS=1500
# Модель векторов книг (таблица embedding_models) для «похожих книг»
EMBEDDING_MODEL=intfloat/multilingual-e5-base
