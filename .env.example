# Скопировать в .env и поменять пароли. .env в git не попадает.

# --- PostgreSQL (docker-compose.yml) ---
POSTGRES_USER=bookmind
POSTGRES_PASSWORD=change-me
POSTGRES_DB=bookmind
POSTGRES_PORT=5432

# --- Бэкенд (backend/) ---
DATABASE_URL=postgresql://bookmind:change-me@localhost:5432/bookmind
# База для тестов создаётся автоматически при `npm test`
TEST_DATABASE_URL=postgresql://bookmind:change-me@localhost:5432/bookmind_test
# Секрет для подписи JWT: длинная случайная строка
JWT_SECRET=change-me-to-a-long-random-string
PORT=3000
# Адрес фронтенда для CORS (Vite)
CORS_ORIGIN=http://localhost:5173
